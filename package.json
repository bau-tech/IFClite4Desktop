{
  "name": "ifclite4desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MPL-2.0",
  "description": "Windows desktop IFC viewer built on IFC-Lite, Three.js (WebGL) and Tauri",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p viewer-host",
    "viewer:build": "node viewer-host/build-viewer.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build"
  },
  "dependencies": {
    "@ifc-lite/data": "^6.2.0",
    "@ifc-lite/geometry": "^7.8.1",
    "@ifc-lite/parser": "^9.5.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/three": "^0.186.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
